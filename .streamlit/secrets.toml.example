# Streamlit Secrets 配置示例
# 复制此文件为 secrets.toml 并填入你的 API Key

# LLM 配置（支持 OpenAI 兼容格式）
[llm]
api_key = "your-api-key-here"
base_url = "https://api.openai.com/v1"  # 可替换为其他兼容服务
model = "gpt-3.5-turbo"
temperature = 0.7
max_tokens = 2000

# 嵌入模型配置（默认使用与 LLM 相同的配置）
[embedding]
api_key = "your-api-key-here"  # 如果与 LLM 相同可省略
base_url = "https://api.openai.com/v1"
model = "text-embedding-ada-002"

# RAG 配置
[rag]
chunk_size = 1000
chunk_overlap = 200
top_k = 4

